package in.sp.beans;

public class HRDepartment implements Department{
	private String deptName;
	private String hrManager;
	private int openPosition;

	public void setDeptName(String deptName) {
		this.deptName = deptName;
	}
	public void setHrManager(String hrManager) {
		this.hrManager = hrManager;
	}
	public void setOpenPosition(int openPosition) {
		this.openPosition = openPosition;
	}
	@Override
	public String getDeptDetails() {
		return "| DeptName"+deptName+"| HRManager"+hrManager+"| OpenPosition"+openPosition;

	}

}
