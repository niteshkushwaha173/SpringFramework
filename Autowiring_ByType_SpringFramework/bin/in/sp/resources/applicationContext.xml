<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<bean class="in.sp.beans.Address" id="address123">
		<property name="houseNo" value="1225" />
		<property name="city" value="Mumbai" />
		<property name="pincode" value="124304" />
	</bean>

	<bean class="in.sp.beans.Student" id="stdId" autowire="byType">
		<property name="id" value="1" />
		<property name="name" value="nitesh" />
		<property name="rollno" value="2" />
		<property name="marks" value="5" />
	</bean>
</beans>
